<!--
  RS-02 QDD 単関節システム同定用 MuJoCo モデル
  ギア比 7.75:1、ピークトルク 17 Nm

  同定対象パラメータ（<joint> の以下の属性）:
    armature:     反射ロータ慣性 [kg·m²]
    frictionloss: クーロン摩擦   [Nm]
    damping:      粘性摩擦       [Nm/(rad/s)]

  初期値の根拠:
    armature:     RS-02ロータ ≈ 30 g·cm² → 0.0003 kg·m²、ギア反射で × 7.75² ≈ 0.018
                  実測前は保守的に 0.01 からスタート
    frictionloss: 典型的なQDDで 0.05–0.3 Nm、0.10 から
    damping:      速度比例摩擦は小さめ、0.05 から
-->
<mujoco model="rs02_joint">
  <compiler angle="radian" autolimits="false"/>

  <!-- timestep=0.001 → 記録レート 1 kHz と一致; RK4 で剛性摩擦モデルに対応 -->
  <option timestep="0.001" integrator="RK4"/>

  <default>
    <joint armature="0.01" frictionloss="0.10" damping="0.05"/>
    <motor gear="1"/>
  </default>

  <worldbody>
    <body name="motor_base" pos="0 0 0">
      <body name="output_link" pos="0 0 0">
        <!--
          range: ±4π rad（AobaDriverのスケールファクタ上限 = 記録可能な最大範囲）
          actuatorfrcrange: RS-02 ピークトルク ±17 Nm
        -->
        <joint name="joint0"
               type="hinge"
               axis="0 0 1"
               range="-12.566 12.566"
               actuatorfrcrange="-17 17"/>
        <!-- 出力軸のみの慣性（付加質量なし）: 短い円柱を仮定 -->
        <inertial pos="0 0 0.05" mass="0.05" diaginertia="5e-5 5e-5 1e-6"/>
        <!-- 衝突なし（contype=0 conaffinity=0）: sysidに不要 -->
        <geom type="cylinder" size="0.02 0.05" pos="0 0 0.05"
              rgba="0.4 0.6 0.8 1" contype="0" conaffinity="0"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- ctrl[0] = トルク [Nm]、gear=1 で関節力と 1:1 対応 -->
    <motor name="torque_cmd" joint="joint0" ctrlrange="-17 17"/>
  </actuator>
</mujoco>
