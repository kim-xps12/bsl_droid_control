<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>biped_bringup</name>
  <version>0.1.0</version>
  <description>Launch and configuration integration for BSL-Droid walking control system</description>
  <maintainer email="kim.xps12@gmail.com">user</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>biped_description</exec_depend>
  <exec_depend>biped_msgs</exec_depend>
  <exec_depend>biped_teleop</exec_depend>
  <exec_depend>biped_rl_policy</exec_depend>
  <exec_depend>biped_safety</exec_depend>
  <exec_depend>biped_genesis_sim</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
