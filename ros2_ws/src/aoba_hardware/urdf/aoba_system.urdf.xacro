<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="aoba_robot">

  <!-- ================================================================== -->
  <!-- Xacro macro for a RobStride motor joint (ros2_control definition)  -->
  <!-- ================================================================== -->
  <xacro:macro name="aoba_joint" params="name can_interface motor_id kp kd">
    <joint name="${name}">
      <param name="can_interface">${can_interface}</param>
      <param name="motor_id">${motor_id}</param>
      <param name="kp">${kp}</param>
      <param name="kd">${kd}</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <!-- ================================================================== -->
  <!-- Full robot model from aoba_description                             -->
  <!-- ================================================================== -->
  <xacro:include filename="$(find aoba_description)/urdf/aoba.xacro"/>

  <!-- ================================================================== -->
  <!-- ros2_control configuration: 10 joints on 2 CAN buses              -->
  <!-- ================================================================== -->
  <ros2_control name="aoba_system" type="system">
    <hardware>
      <plugin>aoba_hardware/AobaHardware</plugin>
    </hardware>

    <!-- Left leg (CAN1) -->
    <xacro:aoba_joint name="rev11" can_interface="can1" motor_id="11" kp="30.0" kd="1.0"/>
    <xacro:aoba_joint name="rev12" can_interface="can1" motor_id="12" kp="30.0" kd="1.0"/>
    <xacro:aoba_joint name="rev13" can_interface="can1" motor_id="13" kp="30.0" kd="1.0"/>
    <xacro:aoba_joint name="rev14" can_interface="can1" motor_id="14" kp="30.0" kd="1.0"/>
    <xacro:aoba_joint name="rev15" can_interface="can1" motor_id="15" kp="30.0" kd="1.0"/>

    <!-- Right leg (CAN2) -->
    <xacro:aoba_joint name="rev21" can_interface="can2" motor_id="21" kp="30.0" kd="1.0"/>
    <xacro:aoba_joint name="rev22" can_interface="can2" motor_id="22" kp="30.0" kd="1.0"/>
    <xacro:aoba_joint name="rev23" can_interface="can2" motor_id="23" kp="30.0" kd="1.0"/>
    <xacro:aoba_joint name="rev24" can_interface="can2" motor_id="24" kp="30.0" kd="1.0"/>
    <xacro:aoba_joint name="rev25" can_interface="can2" motor_id="25" kp="30.0" kd="1.0"/>
  </ros2_control>

</robot>
