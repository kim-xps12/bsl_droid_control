{
  "env": {
    "PATH": "$HOME/.local/bin:$HOME/.pixi/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "PYTHONUNBUFFERED": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"
  },
  "permissions": {
    "allow": [
      "Bash(cp biped_walking/train/droid_train_*.py biped_walking/train/droid_train_*.py)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(uv run python biped_walking/biped_eval.py *)",
      "Bash(uv run python biped_walking/train/droid_train_narrow_v*)",
      "Bash(uv run python biped_walking/train/droid_train_unitree_v*)",
      "Bash(uv run python biped_walking/train/droid_train_omni_v*)",
      "Bash(uv run python scripts/analyze_training_log.py *)",
      "Bash(uv run python scripts/show_reward_components.py *)",
      "Bash(uv run python scripts/analyze_eval_csv.py *)",
      "Bash(uv run python scripts/analyze_directional_eval.py *)",
      "Bash(tmux *)",
      "Bash(tmux kill-pane *)",
      "Bash(cat /private/tmp/claude-*/**/tasks/*.output *)",
      "Bash(tail *)",
      "Bash(ln -sf *)",
      "Bash(pixi run:*)",
      "Bash(pixi install:*)",
      "Bash(pkill -f ros2_control_node)",
      "Bash(pkill -f spawner)",
      "Bash(find /home/user/bsl_droid_control -name \"*.py\" -path \"*/rl_ws/*\" -exec grep -l \"axis\\\\|negate\\\\|sign.*joint\" {} \\\\;)",
      "Bash(find /home/user/bsl_droid_control -type f \\\\\\( -name \"*.py\" -o -name \"*.cpp\" -o -name \"*.h\" \\\\\\) -exec grep -l \"motor_id\\\\|can_interface\" {} \\\\;)",
      "Bash(ls /home/user/bsl_droid_control/ros2_ws/install/aoba_description/share/aoba_description/config/plotjuggler*)",
      "Bash(git add:*)",
      "Bash(git commit -m ':*)",
      "Read(//dev/shm/**)",
      "Bash(ls /tmp/launch_params_*)",
      "Bash(candump -n 1 -T 1000 can1)",
      "Bash(candump -n 1 -T 1000 can2)",
      "Bash(wait)",
      "Read(//home/user/robstride-python/examples/**)",
      "Read(//home/user/robstride-python/**)",
      "Read(//sys/class/net/**)",
      "Bash(cat /etc/udev/rules.d/*can*)",
      "Bash(ip -d link show type can)",
      "Bash(sudo udevadm:*)",
      "Read(//etc/systemd/network/**)",
      "Read(//sys/bus/usb/devices/**)",
      "Read(//usr/lib/udev/rules.d/**)",
      "Read(//usr/lib/systemd/network/**)",
      "Bash(ls -la /etc/systemd/network/10-can*.link)",
      "Bash(find /home/user/bsl_droid_control/ros2_ws/src -type f \\\\\\( -name \"*.py\" -o -name \"*.cpp\" -o -name \"*.hpp\" \\\\\\) -exec grep -l \"clamp\\\\|saturate\\\\|limit.*command\\\\|validate.*joint\" {} \\\\;)",
      "Bash(grep -E \"\\\\.py$\")",
      "Bash(ros2 topic:*)",
      "Read(//proc/bus/input/**)",
      "Bash(lsmod)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-check.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/cpp-lint-check.sh",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "plansDirectory": "./.claude/plans"
}
